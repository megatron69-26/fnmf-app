<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:background="@color/tv_bg"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Danh sách theo dõi"
            android:textColor="@color/tv_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWatchlistStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRỰC TIẾP"
            android:textColor="#089981"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnAddWatchlist"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="+ Thêm"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_percent_badge" />

    </LinearLayout>

    <!-- Offline Banner Notice -->
    <TextView
        android:id="@+id/tvOfflineNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D32F2F"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:padding="6dp"
        android:gravity="center"
        android:text="CHẾ ĐỘ NGOẠI TUYẾN: Hiển thị giá đã lưu trên thiết bị"
        android:visibility="gone" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/tv_surface" />

    <!-- Header columns -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Tên / Cặp tiền"
            android:textColor="@color/tv_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:text="Giá (USD)"
            android:gravity="end"
            android:textColor="@color/tv_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="24h %"
            android:gravity="end"
            android:textColor="@color/tv_text_secondary"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/tv_surface" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ProgressBar Loading -->
        <ProgressBar
            android:id="@+id/pbWatchlist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Empty / Error Message -->
        <TextView
            android:id="@+id/tvEmptyWatchlist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/tv_text_secondary"
            android:textSize="14sp"
            android:text="Đang tải danh sách theo dõi..."
            android:visibility="gone" />

        <!-- RecyclerView danh sách -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvWatchlist"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

    </FrameLayout>

</LinearLayout>
