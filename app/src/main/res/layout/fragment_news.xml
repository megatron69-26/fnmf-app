<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tv_bg">

    <!-- Header Bar giống Danh mục -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@color/tv_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/tvNewsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/news_header_title"
            android:textColor="@color/tv_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNewsCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tv_text_secondary"
            android:textSize="11sp"
            android:layout_marginEnd="8dp"
            android:accessibilityLiveRegion="none"
            tools:text="Tự cập nhật sau: 14:59" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewsRefresh"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="@string/btn_refresh_caps"
            android:textSize="11sp"
            android:textColor="@color/tv_blue"
            app:strokeColor="@color/tv_blue"
            app:strokeWidth="1dp"
            app:cornerRadius="6dp"
            android:backgroundTint="@color/tv_surface"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNewsQuota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/refresh_quota_default"
        tools:text="Còn 5 lượt làm mới hôm nay"
        android:textColor="@color/tv_text_secondary"
        android:textSize="13sp"
        android:textAlignment="center"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="4dp" />

    <TextView
        android:id="@+id/tvNewsStaleWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/news_stale_warning"
        android:textColor="@color/tv_yellow"
        android:textSize="12sp"
        android:textAlignment="center"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:visibility="gone" />

    <!-- Inline Fini Loading khi đồng bộ nền / làm mới trong khi danh sách hiển thị -->
    <com.example.nhumonglenh.ui.common.FiniLoadingView
        android:id="@+id/finiInlineNews"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="4dp"
        app:finiSize="inline"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshNews"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNews"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/tv_bg"
                android:clipToPadding="false"
                android:paddingVertical="8dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Full Fini Loading khi cold start -->
        <com.example.nhumonglenh.ui.common.FiniLoadingView
            android:id="@+id/finiLoadingNews"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:finiSize="full"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvNewsError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:gravity="center"
            android:textColor="@color/tv_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

    </FrameLayout>
</LinearLayout>
