<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#151C28"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#334155" />

    <!-- Warning Sandbox Badge (Removed from active UI) -->
    <TextView
        android:id="@+id/tv_sandbox_warning_badge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Title -->
    <TextView
        android:id="@+id/tv_sheet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/sandbox_deposit_vnpay_title"
        android:textColor="#F8FAFC"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_sheet_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/payment_deposit_subtitle"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <!-- Current Balance & Projected Balance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="#0B0E14"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Số dư hiện tại:"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_sheet_current_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#F8FAFC"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Số dư sau giao dịch:"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_sheet_projected_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#34D399"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Amount Input Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_amount_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColorHint="#94A3B8"
        app:boxBackgroundColor="#0B0E14"
        app:boxStrokeColor="#38BDF8"
        app:errorEnabled="true"
        app:hintTextColor="#38BDF8">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_amount_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Số tiền USD (ví dụ: 500.00)"
            android:inputType="numberDecimal"
            android:textColor="#F8FAFC"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Conversion / Provider Info -->
    <TextView
        android:id="@+id/tv_sheet_conversion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="#0F172A"
        android:padding="10dp"
        android:text="Số tiền quy đổi: $0.00 USD ≈ 0 VND (25,000 VND/USD)"
        android:textColor="#38BDF8"
        android:textSize="12sp"
        android:visibility="visible" />

    <!-- Presets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_preset_100"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/payment_preset_100"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            app:cornerRadius="6dp"
            app:strokeColor="#334155" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_preset_500"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/payment_preset_500"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            app:cornerRadius="6dp"
            app:strokeColor="#334155" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_preset_1000"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/payment_preset_1000"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            app:cornerRadius="6dp"
            app:strokeColor="#334155" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_preset_5000"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/payment_preset_5000"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            app:cornerRadius="6dp"
            app:strokeColor="#334155" />
    </LinearLayout>

    <!-- Submit Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirm_payment"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#0284C7"
        android:text="@string/payment_confirm_deposit"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="8dp" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/pb_sheet_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

</LinearLayout>
