<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@color/tv_border" />

        <!-- Header: Order Type Badge, Symbol, Close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvOrderTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/tv_green"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="LỆNH MUA"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOrderSymbol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="BTC/USDT"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDismissSheet"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/tv_text_secondary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Market Price Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/tv_bg"
            app:cardCornerRadius="8dp"
            app:strokeColor="@color/tv_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/order_ticket_market_price_label"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvOrderMarketPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    tools:text="$78,000.00"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Balance & Holdings Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/tv_bg"
            app:cardCornerRadius="8dp"
            app:strokeColor="@color/tv_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/order_ticket_available_cash_label"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvOrderAvailableCash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="—"
                        tools:text="$10,000.00 USD"
                        android:textColor="@color/tv_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="8dp"
                    android:background="@color/tv_border" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/order_ticket_owned_qty_label"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvOrderOwnedQty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="—"
                        tools:text="0.0000 BTC"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quantity Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilOrderQuantity"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColorHint="@color/tv_text_secondary"
            app:boxBackgroundColor="@color/tv_bg"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxStrokeColor="@color/tv_border"
            app:hintTextColor="@color/tv_green">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etOrderQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/order_ticket_qty_hint"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Quick Percent Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuick25"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/order_ticket_quick_25"
                android:textColor="@color/tv_text_primary"
                android:textSize="12sp"
                app:cornerRadius="6dp"
                app:strokeColor="@color/tv_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuick50"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/order_ticket_quick_50"
                android:textColor="@color/tv_text_primary"
                android:textSize="12sp"
                app:cornerRadius="6dp"
                app:strokeColor="@color/tv_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuick75"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/order_ticket_quick_75"
                android:textColor="@color/tv_text_primary"
                android:textSize="12sp"
                app:cornerRadius="6dp"
                app:strokeColor="@color/tv_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuick100"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text="@string/order_ticket_quick_100"
                android:textColor="@color/tv_text_primary"
                android:textSize="12sp"
                app:cornerRadius="6dp"
                app:strokeColor="@color/tv_border" />
        </LinearLayout>

        <!-- Calculation Breakdown Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/tv_bg"
            app:cardCornerRadius="8dp"
            app:strokeColor="@color/tv_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/order_ticket_est_value_label"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvOrderEstimatedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        tools:text="$0.00 USD"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRemainingLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/order_ticket_remaining_cash_label"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvOrderRemainingValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        tools:text="$10,000.00 USD"
                        android:textColor="@color/tv_green"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Validation Error Message Banner -->
        <TextView
            android:id="@+id/tvOrderErrorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:paddingHorizontal="4dp"
            android:textColor="@color/tv_red"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Submitting progress indicator -->
        <ProgressBar
            android:id="@+id/pbOrderSubmitting"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOrderCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/order_ticket_btn_cancel"
                android:textColor="@color/tv_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:strokeColor="@color/tv_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOrderConfirm"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="2"
                android:backgroundTint="@color/tv_green"
                android:text="@string/order_ticket_btn_confirm_buy"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
