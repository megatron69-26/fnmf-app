<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/tv_surface"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:strokeColor="#2A2E39"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Hàng 1: Mã tài sản & Lời/Lỗ chưa chốt (Unrealized PnL) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_holding_symbol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="BTCUSDT"
                android:textColor="@color/tv_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_holding_pnl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="+$0.00 (0.00%)"
                android:textColor="@color/tv_green"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#232733"
            android:layout_marginVertical="8dp" />

        <!-- Hàng 2: Chi tiết số lượng, Giá mua TB, Giá hiện tại -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khối lượng nắm giữ"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_holding_quantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="0.0000"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giá vốn (TB)"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_holding_avg_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="$0.00"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Giá thị trường"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_holding_current_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="$0.00"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>