<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshForecast"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollForecast"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#131722">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header Bar giống Danh mục -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:background="@color/tv_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvForecastTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/forecast_market_title"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvForecastCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="11sp"
                    android:layout_marginEnd="8dp"
                    android:accessibilityLiveRegion="none"
                    tools:text="Tự cập nhật sau: 23:59:59" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnForecastRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:text="@string/btn_refresh_caps"
                    android:textSize="11sp"
                    android:textColor="@color/tv_blue"
                    app:strokeColor="@color/tv_blue"
                    app:strokeWidth="1dp"
                    app:cornerRadius="6dp"
                    android:backgroundTint="@color/tv_surface"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvForecastQuota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/refresh_quota_default"
                tools:text="Còn 5 lượt làm mới hôm nay"
                android:textColor="#D1D4DC"
                android:textSize="13sp"
                android:textAlignment="center"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvForecastSymbol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOÀN THỊ TRƯỜNG"
                tools:text="TOÀN THỊ TRƯỜNG"
                android:textColor="#2962FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_marginBottom="8dp"/>

            <!-- Inline Fini Loading khi revalidate hoặc manual refresh trong khi có cache -->
            <com.example.nhumonglenh.ui.common.FiniLoadingView
                android:id="@+id/finiInlineForecast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="8dp"
                app:finiSize="inline"
                android:visibility="gone" />

            <!-- Full Fini Loading khi cold start chưa có dữ liệu -->
            <com.example.nhumonglenh.ui.common.FiniLoadingView
                android:id="@+id/finiLoadingForecast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="24dp"
                app:finiSize="full"
                android:visibility="gone" />
        <TextView
            android:id="@+id/tvForecastResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#089981"
            android:textSize="16sp"
            android:textAlignment="center"
            android:visibility="gone"/>
        <LinearLayout
            android:id="@+id/llForecastContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvForecastTimestamp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#787B86"
                android:textSize="12sp"
                android:gravity="center"
                android:textAlignment="center"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                tools:text="Cập nhật lúc 08:43, 18/09/2026" />

            <TextView
                android:id="@+id/tvForecastStaleWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_percent_badge"
                android:backgroundTint="#40E5A93C"
                android:textColor="#FFD54F"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="8dp"
                android:layout_marginBottom="12dp"
                android:text="@string/forecast_stale_warning"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E222D"
                android:padding="16dp"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NHẬN ĐỊNH"
                    android:textColor="#787B86"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvRecommendation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="—"
                    tools:text="MUA MẠNH"
                    android:textColor="#089981"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>
                <TextView
                    android:id="@+id/tvConfidence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="—"
                    tools:text="Độ tin cậy: 95%"
                    android:textColor="#D1D4DC"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E222D"
                android:padding="16dp"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HỖ TRỢ"
                        android:textColor="#787B86"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tvSupport"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        tools:text="62,000"
                        android:textColor="#089981"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KHÁNG CỰ"
                        android:textColor="#787B86"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tvResistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        tools:text="68,000"
                        android:textColor="#F23645"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E222D"
                android:padding="16dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KỊCH BẢN THAM KHẢO"
                    android:textColor="#F5C518"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvTechOutlook"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="—"
                    tools:text="Dự báo kỹ thuật..."
                    android:textColor="#D1D4DC"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BỐI CẢNH THỊ TRƯỜNG"
                    android:textColor="#2962FF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvFundOutlook"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="—"
                    tools:text="Bối cảnh vĩ mô..."
                    android:textColor="#D1D4DC"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LUẬN ĐIỂM THEN CHỐT"
                    android:textColor="#26A69A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"/>
                <TextView
                    android:id="@+id/tvKeyDrivers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#D1D4DC"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
