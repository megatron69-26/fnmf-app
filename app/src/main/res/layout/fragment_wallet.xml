<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg">

    <!-- Nội dung chính khi tải thành công -->
    <LinearLayout
        android:id="@+id/layout_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/tv_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <TextView
                android:id="@+id/tv_wallet_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/wallet_title"
                android:textColor="@color/tv_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_last_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tv_text_secondary"
                android:textSize="11sp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_wallet_refresh"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/btn_refresh"
                android:textSize="11sp"
                android:textColor="@color/tv_green"
                app:strokeColor="@color/tv_green"
                app:strokeWidth="1dp"
                app:cornerRadius="6dp"
                android:backgroundTint="@color/tv_surface"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />
        </LinearLayout>

        <!-- Offline Banner -->
        <TextView
            android:id="@+id/tv_offline_badge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2A2E39"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:text="@string/offline_badge"
            android:textColor="#F39C12"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <!-- 1. Card Số dư tiền mặt & Nạp/Rút -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_wallet_balance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="@color/tv_surface"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#2A2E39"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wallet_balance_header"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/tv_cash_balance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp" />

                        <!-- Buttons: NẠP TIỀN & RÚT TIỀN (LTR: Deposit Left, Withdraw Right) -->
                        <LinearLayout
                            android:id="@+id/layout_wallet_buttons_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layoutDirection="ltr">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_sandbox_deposit"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:minHeight="48dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:layout_marginRight="6dp"
                                android:backgroundTint="@color/tv_green"
                                android:text="@string/wallet_btn_deposit"
                                android:textColor="#022C22"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:cornerRadius="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_sandbox_withdraw"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:minHeight="48dp"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                android:layout_marginLeft="6dp"
                                android:backgroundTint="#EF4444"
                                android:text="@string/wallet_btn_withdraw"
                                android:textColor="#450A0A"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:cornerRadius="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Card Lịch sử nạp/rút gần nhất -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_payment_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="@color/tv_surface"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#2A2E39"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="LỊCH SỬ NẠP / RÚT GẦN NHẤT"
                                android:textColor="@color/tv_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.04" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_refresh_payments"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingHorizontal="6dp"
                                android:text="Làm mới"
                                android:textSize="11sp"
                                android:textColor="@color/tv_blue" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/pb_payments_loading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginVertical="8dp"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_payments"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />

                        <TextView
                            android:id="@+id/tv_payments_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingVertical="14dp"
                            android:text="Chưa có giao dịch nạp/rút nào"
                            android:textColor="@color/tv_text_secondary"
                            android:textSize="12sp"
                            android:visibility="gone" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Overlay Loading -->
    <LinearLayout
        android:id="@+id/layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99131722"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:indeterminateTint="@color/tv_green" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/loading_data"
            android:textColor="@color/tv_text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Overlay Error -->
    <LinearLayout
        android:id="@+id/layout_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tv_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/network_error_msg"
            android:textColor="@color/tv_text_primary"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_retry"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/tv_green"
            app:cornerRadius="8dp" />
    </LinearLayout>
</FrameLayout>
